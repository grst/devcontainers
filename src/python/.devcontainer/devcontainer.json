{
  "name": "python (uv + Claude Code)",
  "image": "ghcr.io/grst/devcontainers/python:${templateOption:imageTag}",

  // Rootless podman. keep-id maps the host uid to the same uid inside the container
  // so workspace files keep their ownership; label=disable avoids SELinux
  // relabelling. The CLI adds both itself when it detects podman, but that is
  // undocumented internal behaviour and VS Code takes a different path, so they stay
  // explicit -- a duplicate on the podman command line is harmless.
  //
  // NET_ADMIN and NET_RAW are unconditional, not only for firewall=on. In a rootless
  // user namespace they confer power over the container's own network namespace and
  // nothing else, so turning the firewall on later is a one-word edit.
  "runArgs": [
    "--userns=keep-id",
    "--security-opt=label=disable",
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    // map-host-loopback lets the container reach services on the host's loopback,
    // which is how the peon-ping relay is reached (still blocked under firewall=on
    // unless post-create.sh installs the peon allowlist fragment).
    //
    // 169.254.1.1 specifically, which is podman's own default for this mapping -- do not
    // "tidy" it to another link-local address. When the host resolves through a stub
    // resolver on loopback (systemd-resolved, a VPN), podman writes 169.254.1.1 into the
    // container's /etc/resolv.conf in its place. Pointing the mapping somewhere else
    // leaves that nameserver aimed at nothing, and the container has no working DNS at
    // all: `claude` cannot reach the API and curl fails on every name. It only shows up
    // when the host happens to be using a loopback resolver, so it looks intermittent.
    "--network=pasta:--map-host-loopback,169.254.1.1",

    // --- podman inside the container -----------------------------------------
    // The image ships rootless podman (see the Dockerfile's nested-containers
    // section) so an agent never needs a host runtime socket, which
    // devcontainer-isolation refuses. These four are what it takes, and podman
    // reports none of them by name when they are missing.
    //
    // SYS_ADMIN is the one that looks alarming and is not. newuidmap, which maps the
    // nested subuid range, is setuid-root -- but euid 0 is not the *owner* of the
    // user namespace it is mapping (the container user is), so the kernel stops
    // consulting the owner rule and demands CAP_SYS_ADMIN over that namespace
    // instead. Without it every podman command dies on `newuidmap: write to uid_map
    // failed: Operation not permitted`.
    //
    // What it does not buy an agent in here, because this is a *rootless* user
    // namespace and the capability is scoped to it: nothing on the host (the kernel
    // checks against the host's namespace, where this container is an unprivileged
    // uid), no remounting a read-only bind read-write (mounts inherited by a user
    // namespace are locked, so /opt/peon-ping stays read-only), and no writing a
    // non-namespaced sysctl. smoke.sh probes those rather than trusting this comment.
    "--cap-add=SYS_ADMIN",
    // podman masks or read-only-mounts a dozen paths under /proc, and the kernel
    // refuses to mount a fresh procfs in a nested container while any of them are
    // there -- a new proc mount may not hide locked submounts -- so every `podman
    // run` failed with ``mount `proc` to `proc`: Operation not permitted``.
    // Unmasking them is safe for the same reason as above: /proc/sys/kernel and
    // friends belong to the host's namespace and stay unwritable, while the
    // /proc/sys/net values a nested container really does set belong to its own
    // network namespace.
    "--security-opt=unmask=/proc/*",
    // /dev/net/tun is required, not optional: pasta builds the nested container's
    // network on a tap device and fails with `Failed to open() /dev/net/tun`
    // otherwise. /dev/fuse is the fallback storage path -- podman uses the kernel's
    // overlay where an unprivileged mount is allowed and fuse-overlayfs where it is
    // not, and it cannot know which until it tries.
    "--device=/dev/net/tun",
    "--device=/dev/fuse"
  ],

  "containerUser": "vscode",
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",

  // Runs on the HOST before the container is created. Only job: make sure the
  // peon-ping bind source exists, because podman refuses to start when a bind
  // source is missing and not every machine has peon-ping installed. An empty
  // directory is harmless -- post-create.sh checks for an executable peon.sh
  // before wiring anything up.
  "initializeCommand": "mkdir -p \"${localEnv:HOME}/.claude/hooks/peon-ping\"",

  // Everything except the workspace is either a named volume (podman's own
  // storage, not a host path) or read-only. devcontainer-isolation enforces this
  // against /etc/devcontainer/mount-allowlist.txt on every start.
  //
  // ${devcontainerId} keys the volumes to this repo automatically, so nothing has
  // to be renamed per project and two repos never share an agent login or cache.
  "mounts": [
    "source=claude-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    // Copilot CLI's own login and state ($COPILOT_HOME), so `copilot login`
    // survives a rebuild the same way a Claude Code login does.
    "source=copilot-config-${devcontainerId},target=/home/vscode/.copilot,type=volume",
    "source=cache-${devcontainerId},target=/home/vscode/.cache,type=volume",
    // Images and layers pulled by the container's own podman. On a volume for the
    // usual reason -- a pull survives a rebuild -- and for one specific to it: the
    // kernel will not stack overlay on overlay, so a graph root left inside the
    // container's own filesystem forces the slower fuse-overlayfs path.
    "source=containers-${devcontainerId},target=/home/vscode/.local/share/containers,type=volume",
    "source=uv-${devcontainerId},target=/home/vscode/.local/share/uv,type=volume",
    "source=hatch-${devcontainerId},target=/home/vscode/.local/share/hatch,type=volume",
    "source=history-${devcontainerId},target=/commandhistory,type=volume",
    "source=${localEnv:HOME}/.claude/hooks/peon-ping,target=/opt/peon-ping,type=bind,readonly"
  ],

  "containerEnv": {
    // The choice that has no default. devcontainer-firewall refuses to let the
    // container start unless this is exactly "on" or "off".
    "DEVCONTAINER_FIREWALL": "${templateOption:firewall}",
    "DEVCONTAINER_PEON": "${templateOption:peonPing}",

    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    // Tells Claude Code it is inside a sandboxed container, which is what makes
    // bypassPermissions available at all. Sessions still start in auto mode.
    "IS_SANDBOX": "1",

    // Default interpreter for a project that pins nothing.
    "UV_PYTHON": "${templateOption:pythonVersion}",

    // Force commit signing off regardless of any gitconfig. The host ~/.gitconfig
    // sets commit.gpgSign with an SSH key under ~/.ssh, nothing from ~/.ssh is
    // mounted, and VS Code copies that file in unless copyGitConfig is false --
    // without this override every commit in the container would fail.
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "commit.gpgsign",
    "GIT_CONFIG_VALUE_0": "false",

    // peon-ping's autodetection looks for /.dockerenv or REMOTE_CONTAINERS, and
    // podman writes /run/.containerenv instead, so it would otherwise think it is
    // on a plain Linux host and try to play audio in the container.
    "PEON_PLATFORM": "devcontainer",
    "CLAUDE_PEON_DIR": "/opt/peon-ping"
  },

  // remoteEnv rather than containerEnv for the secrets: containerEnv is baked into
  // the container at creation time and shows up in `podman inspect`, while
  // remoteEnv is injected into each command the CLI runs, so a rotated token takes
  // effect in the next shell instead of needing the container recreated.
  //
  // GH_TOKEN must be READ-ONLY -- see host-secrets.sh for why.
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // Both run on every start, and a non-zero exit fails `devcontainer up`. Order
  // matters: prove the container is isolated before opening any network.
  "postStartCommand": "sudo /usr/local/bin/devcontainer-isolation && sudo /usr/local/bin/devcontainer-firewall",

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "eamodio.gitlens",
        "editorconfig.editorconfig",
        "vscodevim.vim",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "mechatroner.rainbow-csv",
        "github.vscode-github-actions"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
        // The venv is on PATH via uv, and letting the extension source an
        // activate script in every terminal fights with direnv.
        "python.terminal.activateEnvironment": false,
        "terminal.integrated.defaultProfile.linux": "zsh",

        "editor.formatOnSave": true,
        "editor.acceptSuggestionOnEnter": "off",
        "editor.rulers": [120],
        "editor.minimap.enabled": false,
        "files.enableTrash": false,
        "workbench.colorTheme": "Solarized Dark",

        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },

        "vim.useSystemClipboard": true,
        "vim.useCtrlKeys": false,

        "jupyter.askForKernelRestart": false,
        "debugpy.debugJustMyCode": false
      }
    }
  }
}
